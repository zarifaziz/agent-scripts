#!/usr/bin/env bash
#
# Example AMP_PERMISSION_PROMPT_HANDLER
#
# Receives JSON on stdin with schema:
# {
#   "title": "CONFIRM" | "SENSITIVE" | "OUTSIDE PWD" | "HEREDOC" | etc,
#   "message": "Human readable message",
#   "context": {
#     "cmd": "the full command",
#     "pwd": "/current/working/dir",
#     "tool": "Bash" | "edit_file" | etc,
#     "tmux": "session:window(pane)" | "no-tmux"
#   }
# }
#
# Exit codes:
#   0 = allow
#   1 = deny
#
# Usage:
#   export AMP_PERMISSION_PROMPT_HANDLER=/path/to/this/script
#
# You can customize this to:
#   - Log to a file and auto-allow (dangerous!)
#   - Send notification and wait for webhook
#   - Use a different UI (zenity, yad, rofi, dmenu)
#   - Auto-deny certain patterns
#   - Integrate with a remote approval system

set -uo pipefail

# Read JSON from stdin
input=$(cat)

title=$(echo "$input" | jq -r '.title')
message=$(echo "$input" | jq -r '.message')
cmd=$(echo "$input" | jq -r '.context.cmd')
pwd=$(echo "$input" | jq -r '.context.pwd')
tmux_ctx=$(echo "$input" | jq -r '.context.tmux')

# Example: Auto-allow certain low-risk patterns
case "$title" in
    "OUTSIDE PWD")
        # Auto-allow reads to common locations
        if [[ "$cmd" =~ ^(cat|head|tail|less|wc|file|stat) ]]; then
            exit 0
        fi
        ;;
esac

# Example: Use terminal prompt (similar to built-in TTY)
echo ""
echo "=== AMP PERMISSION ==="
echo "[$tmux_ctx] $title"
echo ""
echo "$message"
echo ""
echo "Command: $cmd"
echo "PWD: $pwd"
echo ""
printf "Allow? [y/N]: "

read -r -t 30 response </dev/tty 2>/dev/null || response="n"

if [[ "$response" =~ ^[Yy]$ ]]; then
    exit 0
else
    exit 1
fi
