{
  "amp.url": "http://localhost:8318",
  "amp.git.commit.ampThread.enabled": true,
  "amp.git.commit.coauthor.enabled": true,
  "amp.guardedFiles.allowlist": [
    "**/.git/hooks/**",
    "Users/mac/.*/**",
    "**/.env*",
    "/Users/mac/.config/**"
  ],
  "amp.notifications.enabled": false,
  "amp.notifications.system.enabled": false,
  "amp.permissions": [
    {
      "tool": "*",
      "action": "delegate",
      "to": "amp-permission"
    }
  ],
  "amp.tools.stopTimeout": 1000,
  "amp.experimental.courseCorrection.enabled": true
}
