#!/usr/bin/env bash
#
# amp-permission-eval - Policy evaluator for Amp (consumes amp-permission-parser JSON)
#
# Exit codes (per Amp spec):
#   0 = allow
#   1 = ask (Amp's terminal prompt - user can reject)
#   2 = reject (blocked, message to model)
#
# Architecture:
#   1. amp-permission-parser (Go) -> JSON with AST analysis
#   2. amp-permission-eval (Bash) -> Variable expansion + policy checks + user prompts
#
# Usage as delegate:
#   Receives AGENT_TOOL_NAME env var and JSON args on stdin
#
# Usage for testing:
#   amp-permission-eval --test '{"cmd": "rm -rf /"}'

set -uo pipefail

# Config
CONFIG_DIR="$HOME/.config/amp-permissions"
LOG_FILE="$CONFIG_DIR/decisions.log"
MAX_LOG_LINES=100
PARSER_BIN="$HOME/.local/bin/amp-permission-parser"

# Script scanning limits (Oracle recommendation)
MAX_SCRIPT_BYTES=102400 # 100KB
MAX_SCRIPT_LINES=2000

# Prompt handler - override with AMP_PERMISSION_PROMPT_HANDLER env var
# Schema: handler receives JSON on stdin: {"title": "...", "message": "...", "context": {...}}
# Handler must exit 0 for allow, non-zero for deny
DEFAULT_PROMPT_HANDLER="$HOME/.local/bin/amp-prompt-handler"
PROMPT_HANDLER="${AMP_PERMISSION_PROMPT_HANDLER:-$DEFAULT_PROMPT_HANDLER}"

mkdir -p "$CONFIG_DIR"

#------------------------------------------------------------------------------
# Config loaders
#------------------------------------------------------------------------------

load_list() {
  local file="$1"
  [[ -f "$file" ]] || return
  grep -v '^#' "$file" | grep -v '^[[:space:]]*$' | sed "s|\$HOME|$HOME|g"
}

load_sensitive_paths() { load_list "$CONFIG_DIR/sensitive-paths.txt"; }
load_reject_patterns() { load_list "$CONFIG_DIR/reject-patterns.txt"; }
load_always_allowed_paths() { load_list "$CONFIG_DIR/always-allowed-paths.txt"; }
load_always_ask_patterns() { load_list "$CONFIG_DIR/always-ask-patterns.txt"; }

#------------------------------------------------------------------------------
# Logging
#------------------------------------------------------------------------------

log_decision() {
  local decision="$1" tool="$2" detail="$3"
  local timestamp=$(date '+%Y-%m-%d %H:%M:%S')
  local tmux_ctx=$(get_tmux_context)
  echo "[$timestamp] [$tmux_ctx] $decision | $tool | $detail" >>"$LOG_FILE"
  if [[ -f "$LOG_FILE" ]]; then
    tail -n "$MAX_LOG_LINES" "$LOG_FILE" >"$LOG_FILE.tmp" && mv "$LOG_FILE.tmp" "$LOG_FILE"
  fi
}

#------------------------------------------------------------------------------
# Helpers
#------------------------------------------------------------------------------

get_tmux_context() {
  if [[ -n "${TMUX:-}" ]]; then
    if [[ -n "${TMUX_PANE:-}" ]]; then
      tmux display-message -t "$TMUX_PANE" -p '#S:#W(#I)' 2>/dev/null || echo "unknown"
    else
      tmux display-message -p '#S:#W(#I)' 2>/dev/null || echo "unknown"
    fi
  else
    echo "no-tmux"
  fi
}

resolve_path() {
  local path="$1"
  [[ -z "$path" ]] && return
  path="${path/#\~/$HOME}"
  path="${path/\$HOME/$HOME}"
  if [[ -e "$path" ]]; then
    realpath "$path" 2>/dev/null || echo "$path"
  else
    local dir=$(dirname "$path")
    local base=$(basename "$path")
    if [[ -e "$dir" ]]; then
      echo "$(realpath "$dir" 2>/dev/null)/$base"
    else
      echo "$path"
    fi
  fi
}

# Safe variable expansion (Oracle recommendation: set -f to prevent globs)
expand_var() {
  local var="$1"
  (
    set -f # Disable glob expansion on attacker content
    eval echo "$var" 2>/dev/null || echo "$var"
  )
}

is_under_pwd() {
  local path="$1"
  local resolved=$(resolve_path "$path")
  local pwd_resolved=$(resolve_path "$WORK_DIR")
  [[ "$resolved" == "$pwd_resolved"* ]]
}

#------------------------------------------------------------------------------
# User prompts - delegates to PROMPT_HANDLER
#------------------------------------------------------------------------------

prompt_user() {
  local title="$1" message="$2"

  if [[ ! -x "$PROMPT_HANDLER" ]]; then
    log_decision "ERROR" "prompt" "handler not found: $PROMPT_HANDLER"
    echo "ERROR: Prompt handler not found: $PROMPT_HANDLER" >&2
    return 1
  fi

  # Build JSON payload matching handler schema
  local payload
  payload=$(jq -n \
    --arg title "$title" \
    --arg message "$message" \
    --arg cmd "${CURRENT_CMD:-}" \
    --arg pwd "$WORK_DIR" \
    --arg tool "$TOOL_NAME" \
    --arg tmux "$(get_tmux_context)" \
    '{title: $title, message: $message, context: {cmd: $cmd, pwd: $pwd, tool: $tool, tmux: $tmux}}')

  echo "$payload" | "$PROMPT_HANDLER"
  return $?
}

#------------------------------------------------------------------------------
# Path checks
#------------------------------------------------------------------------------

is_always_allowed_path() {
  local path="$1"
  local resolved=$(resolve_path "$path")
  while IFS= read -r allowed || [[ -n "$allowed" ]]; do
    [[ -z "$allowed" ]] && continue
    [[ "$resolved" == "$allowed"* ]] && return 0
  done <<<"$(load_always_allowed_paths)"
  return 1
}

matches_sensitive_path() {
  local path="$1"
  local resolved=$(resolve_path "$path")
  while IFS= read -r sensitive || [[ -n "$sensitive" ]]; do
    [[ -z "$sensitive" ]] && continue
    local sensitive_resolved=$(resolve_path "$sensitive")
    if [[ "$resolved" == "$sensitive_resolved"* ]]; then
      echo "$sensitive"
      return 0
    fi
  done <<<"$(load_sensitive_paths)"
  return 1
}

all_paths_always_allowed() {
  local paths="$1"
  [[ -z "$paths" ]] && return 1
  while IFS= read -r p || [[ -n "$p" ]]; do
    [[ -z "$p" ]] && continue
    is_always_allowed_path "$p" || return 1
  done <<<"$paths"
  return 0
}

#------------------------------------------------------------------------------
# Script scanning with limits (Oracle recommendation: byte/line caps + MIME check)
#------------------------------------------------------------------------------

scan_script_file() {
  local script_path="$1"
  local depth="${2:-0}"
  local visited="${3:-}"
  local max_depth=3

  [[ $depth -ge $max_depth ]] && {
    echo "max depth ($max_depth) reached"
    return 0
  }
  [[ ! -f "$script_path" ]] && return 1

  # Size check
  local file_size=$(stat -f%z "$script_path" 2>/dev/null || stat -c%s "$script_path" 2>/dev/null || echo 0)
  if [[ $file_size -gt $MAX_SCRIPT_BYTES ]]; then
    echo "script too large (${file_size} bytes > ${MAX_SCRIPT_BYTES})"
    return 0
  fi

  # MIME check - skip binaries
  local mime_type=$(file -b --mime-type "$script_path" 2>/dev/null)
  if [[ ! "$mime_type" =~ ^text/ ]] && [[ "$mime_type" != "application/x-shellscript" ]]; then
    echo "binary file ($mime_type)"
    return 0
  fi

  # Circular reference check
  [[ "$visited" == *"|$script_path|"* ]] && return 1
  visited="$visited|$script_path|"

  # Line count check
  local line_count=$(wc -l <"$script_path" 2>/dev/null || echo 0)
  if [[ $line_count -gt $MAX_SCRIPT_LINES ]]; then
    echo "script too many lines (${line_count} > ${MAX_SCRIPT_LINES})"
    return 0
  fi

  local content=$(cat "$script_path" 2>/dev/null)
  [[ -z "$content" ]] && return 1

  # Check reject patterns
  while IFS= read -r pattern || [[ -n "$pattern" ]]; do
    [[ -z "$pattern" ]] && continue
    if [[ "$content" == *"$pattern"* ]]; then
      echo "script:$script_path contains '$pattern'"
      return 0
    fi
  done <<<"$(load_reject_patterns)"

  # Check always-ask patterns
  while IFS= read -r pattern || [[ -n "$pattern" ]]; do
    [[ -z "$pattern" ]] && continue
    local file_pattern="${pattern#^}"
    if [[ "$content" =~ $file_pattern ]]; then
      echo "script:$script_path matches '$pattern'"
      return 0
    fi
  done <<<"$(load_always_ask_patterns)"

  return 1
}

#------------------------------------------------------------------------------
# JSON-based evaluation (consumes amp-permission-parser output)
#------------------------------------------------------------------------------

evaluate_parsed_json() {
  local cmd="$1"
  local json="$2"
  CURRENT_CMD="$cmd" # For prompt context

  # Check for parse errors
  local parse_error=$(echo "$json" | jq -r '.error // empty')
  if [[ -n "$parse_error" ]]; then
    log_decision "ASK" "Bash" "parse error: $parse_error"
    exit 1
  fi

  # 1. Check risky patterns from Go parser (ALWAYS first - blocks dangerous commands)
  local risky_count=$(echo "$json" | jq '.risky_patterns | length')
  if [[ $risky_count -gt 0 ]]; then
    local risk_detail=$(echo "$json" | jq -r '.risky_patterns[0].detail')
    log_decision "BLOCK" "Bash" "risky: $risk_detail - $cmd"
    echo "BLOCKED: $risk_detail" >&2
    exit 2
  fi

  # 2. Check pipes to interpreters (BEFORE read-only check - curl|bash bypasses otherwise)
  local pipes_count=$(echo "$json" | jq '.pipes_to_interp | length')
  if [[ $pipes_count -gt 0 ]]; then
    local interp=$(echo "$json" | jq -r '.pipes_to_interp[0].interpreter')
    local tmux_ctx=$(get_tmux_context)
    if prompt_user "[$tmux_ctx] PIPE TO $interp" "Piping to interpreter:\n\n$cmd"; then
      log_decision "ALLOW" "Bash" "user approved pipe to $interp: $cmd"
      exit 0
    else
      log_decision "DENY" "Bash" "user denied pipe to $interp: $cmd"
      exit 1
    fi
  fi

  # 3. Check heredocs (BEFORE read-only check - can inject arbitrary code)
  local heredoc_count=$(echo "$json" | jq '.heredocs | length')
  if [[ $heredoc_count -gt 0 ]]; then
    local tmux_ctx=$(get_tmux_context)
    if prompt_user "[$tmux_ctx] HEREDOC" "Command uses heredoc:\n\n$cmd"; then
      log_decision "ALLOW" "Bash" "user approved heredoc: $cmd"
      exit 0
    else
      log_decision "DENY" "Bash" "user denied heredoc: $cmd"
      exit 1
    fi
  fi

  # 4. Check always-ask patterns from Go parser
  local ask_count=$(echo "$json" | jq '.always_ask | length')
  if [[ $ask_count -gt 0 ]]; then
    local ask_pattern=$(echo "$json" | jq -r '.always_ask[0].pattern')
    local tmux_ctx=$(get_tmux_context)
    if prompt_user "[$tmux_ctx] CONFIRM" "Pattern: $ask_pattern\n\nCmd: $cmd"; then
      log_decision "ALLOW" "Bash" "user approved ($ask_pattern): $cmd"
      exit 0
    else
      log_decision "DENY" "Bash" "user denied ($ask_pattern): $cmd"
      exit 1
    fi
  fi

  # 5. Check sensitive paths BEFORE read-only exit (cat ~/.ssh/id_rsa must prompt)
  local literal_paths=$(echo "$json" | jq -r '.literal_paths[]?' 2>/dev/null)
  if [[ -n "$literal_paths" ]]; then
    while IFS= read -r p || [[ -n "$p" ]]; do
      [[ -z "$p" ]] && continue
      local resolved=$(resolve_path "$p")
      local sensitive_match
      if sensitive_match=$(matches_sensitive_path "$resolved"); then
        local tmux_ctx=$(get_tmux_context)
        if prompt_user "[$tmux_ctx] SENSITIVE" "$p\n\nLocation: $sensitive_match\n\nCmd: $cmd"; then
          log_decision "ALLOW" "Bash" "user approved sensitive read: $cmd"
          exit 0
        else
          log_decision "DENY" "Bash" "user denied sensitive read: $cmd"
          exit 1
        fi
      fi
    done <<<"$literal_paths"
  fi

  # 6. Read-only commands: allow without further path checks (AFTER sensitive path check)
  local is_readonly=$(echo "$json" | jq -r '.is_read_only // false')
  if [[ "$is_readonly" == "true" ]]; then
    log_decision "ALLOW" "Bash" "read-only: $cmd"
    exit 0
  fi

  # 7. Check script paths
  local script_paths=$(echo "$json" | jq -r '.script_paths[]?' 2>/dev/null)
  if [[ -n "$script_paths" ]]; then
    while IFS= read -r sp || [[ -n "$sp" ]]; do
      [[ -z "$sp" ]] && continue
      local resolved_sp=$(resolve_path "$sp")
      local script_risk
      if script_risk=$(scan_script_file "$resolved_sp"); then
        local tmux_ctx=$(get_tmux_context)
        if prompt_user "[$tmux_ctx] SCRIPT RISK" "$script_risk\n\nCmd: $cmd"; then
          log_decision "ALLOW" "Bash" "user approved risky script: $cmd"
          exit 0
        else
          log_decision "DENY" "Bash" "user denied risky script: $cmd"
          exit 1
        fi
      fi
    done <<<"$script_paths"
  fi

  # 5. Expand variables and check paths
  local literal_paths=$(echo "$json" | jq -r '.literal_paths[]?' 2>/dev/null)
  local var_refs=$(echo "$json" | jq -r '.var_references[]?' 2>/dev/null)

  # Expand variable references
  local expanded_paths=""
  if [[ -n "$var_refs" ]]; then
    while IFS= read -r var || [[ -n "$var" ]]; do
      [[ -z "$var" ]] && continue
      local expanded=$(expand_var "$var")
      if [[ "$expanded" != "$var" ]] && [[ -n "$expanded" ]]; then
        expanded_paths+="$expanded"$'\n'
      fi
    done <<<"$var_refs"
  fi

  # Combine literal and expanded paths
  local all_paths=$(printf '%s\n%s' "$literal_paths" "$expanded_paths" | grep -v '^$' | sort -u)

  # 6. If all paths are always-allowed, allow
  if [[ -n "$all_paths" ]] && all_paths_always_allowed "$all_paths"; then
    log_decision "ALLOW" "Bash" "always-allowed paths: $cmd"
    exit 0
  fi

  # 7. No paths or all under PWD - allow
  if [[ -z "$all_paths" ]]; then
    log_decision "ALLOW" "Bash" "no paths: $cmd"
    exit 0
  fi

  # 8. Check paths against PWD and sensitive
  local outside_paths=()
  while IFS= read -r p || [[ -n "$p" ]]; do
    [[ -z "$p" ]] && continue
    if ! is_under_pwd "$p" && ! is_always_allowed_path "$p"; then
      outside_paths+=("$p")
    fi
  done <<<"$all_paths"

  if [[ ${#outside_paths[@]} -eq 0 ]]; then
    log_decision "ALLOW" "Bash" "all paths in PWD: $cmd"
    exit 0
  fi

  # 9. Check each outside path
  local risky_paths=()
  for p in "${outside_paths[@]}"; do
    local resolved=$(resolve_path "$p")

    # Sensitive paths always prompt
    local sensitive_match
    if sensitive_match=$(matches_sensitive_path "$resolved"); then
      local tmux_ctx=$(get_tmux_context)
      if prompt_user "[$tmux_ctx] SENSITIVE" "$p\n\nLocation: $sensitive_match\n\nCmd: $cmd"; then
        log_decision "ALLOW" "Bash" "user approved sensitive: $cmd"
        exit 0
      else
        log_decision "DENY" "Bash" "user denied sensitive: $cmd"
        exit 1
      fi
    fi

    # Single files (not dirs) outside sensitive areas: allow
    if [[ -f "$resolved" ]] || [[ ! -d "$resolved" ]]; then
      continue # File or non-existent path (will be created as file) - safe
    fi

    # Directory paths need review
    risky_paths+=("$p")
  done

  # All paths are single files or in PWD - allow
  if [[ ${#risky_paths[@]} -eq 0 ]]; then
    log_decision "ALLOW" "Bash" "single files only: $cmd"
    exit 0
  fi

  # 10. Directory operations outside PWD - prompt
  local tmux_ctx=$(get_tmux_context)
  if prompt_user "[$tmux_ctx] DIRECTORY OP" "Paths: ${risky_paths[*]}\n\nPWD: $WORK_DIR\n\nCmd: $cmd"; then
    log_decision "ALLOW" "Bash" "user approved directory op: $cmd"
    exit 0
  else
    log_decision "DENY" "Bash" "user denied directory op: $cmd"
    exit 1
  fi
}

#------------------------------------------------------------------------------
# Tool handlers
#------------------------------------------------------------------------------

handle_bash() {
  local cmd=$(echo "$ARGS" | jq -r '.cmd // empty' 2>/dev/null)
  [[ -z "$cmd" ]] && {
    log_decision "ALLOW" "Bash" "empty command"
    exit 0
  }

  # Go parser is required
  if [[ ! -x "$PARSER_BIN" ]]; then
    log_decision "ERROR" "Bash" "Go parser not found: $PARSER_BIN"
    echo "ERROR: amp-permission-parser not found. Run 'make install'" >&2
    exit 2
  fi

  local parsed_json
  parsed_json=$(echo "$cmd" | "$PARSER_BIN" 2>/dev/null)
  if [[ $? -ne 0 ]] || [[ -z "$parsed_json" ]]; then
    log_decision "ERROR" "Bash" "Go parser failed: $cmd"
    echo "ERROR: Failed to parse command" >&2
    exit 2
  fi

  evaluate_parsed_json "$cmd" "$parsed_json"
}

handle_file_tool() {
  local path=$(echo "$ARGS" | jq -r '.path // empty' 2>/dev/null)
  [[ -z "$path" ]] && {
    log_decision "ALLOW" "$TOOL_NAME" "no path"
    exit 0
  }

  # Only prompt for sensitive paths, allow everything else
  local sensitive_match
  if sensitive_match=$(matches_sensitive_path "$path"); then
    local tmux_ctx=$(get_tmux_context)
    if prompt_user "[$tmux_ctx] SENSITIVE FILE" "$path\n\nLocation: $sensitive_match"; then
      log_decision "ALLOW" "$TOOL_NAME" "user approved sensitive: $path"
      exit 0
    else
      log_decision "DENY" "$TOOL_NAME" "user denied sensitive: $path"
      exit 1
    fi
  fi

  # Allow all non-sensitive paths
  log_decision "ALLOW" "$TOOL_NAME" "$path"
  exit 0
}

#------------------------------------------------------------------------------
# CLI commands
#------------------------------------------------------------------------------

cmd_test() {
  local json="$1"
  local tool="${2:-Bash}"

  TOOL_NAME="$tool"
  ARGS="$json"
  WORK_DIR="${PWD:-$(pwd)}"

  echo "Testing: $tool"
  echo "Args: $json"
  echo "PWD: $WORK_DIR"
  echo "Parser: ${PARSER_BIN:-not found}"
  echo "---"

  case "$tool" in
  Bash) handle_bash ;;
  edit_file | create_file) handle_file_tool ;;
  *)
    echo "Unknown tool: $tool"
    exit 1
    ;;
  esac
}

cmd_parse() {
  local cmd="$1"
  if [[ -x "$PARSER_BIN" ]]; then
    echo "$cmd" | "$PARSER_BIN"
  else
    echo "Parser not found: $PARSER_BIN" >&2
    exit 1
  fi
}

cmd_log() {
  if [[ -f "$LOG_FILE" ]]; then
    cat "$LOG_FILE"
  else
    echo "No log entries yet"
  fi
}

cmd_edit() {
  local which="$1"
  local file
  case "$which" in
  readonly) file="$CONFIG_DIR/readonly-commands.txt" ;;
  sensitive) file="$CONFIG_DIR/sensitive-paths.txt" ;;
  reject) file="$CONFIG_DIR/reject-patterns.txt" ;;
  paths) file="$CONFIG_DIR/always-allowed-paths.txt" ;;
  commands) file="$CONFIG_DIR/always-allowed-commands.txt" ;;
  ask) file="$CONFIG_DIR/always-ask-patterns.txt" ;;
  interpreters) file="$CONFIG_DIR/interpreters.txt" ;;
  *)
    echo "Unknown config: $which"
    exit 1
    ;;
  esac
  ${EDITOR:-vim} "$file"
}

cmd_help() {
  cat <<'EOF'
amp-permission-eval - Amp permission evaluator (Go parser + Bash policy)

DELEGATE MODE (called by Amp):
  Receives AGENT_TOOL_NAME env var and JSON args on stdin

CLI MODE:
  --test JSON [TOOL]  Test a command without executing
  --parse CMD         Show Go parser output for a command
  --log               Show decision log
  --edit CONFIG       Edit config (readonly, sensitive, reject, etc.)
  --help              Show this help

ARCHITECTURE:
  1. amp-permission-parser (Go) - AST parsing with mvdan.cc/sh
  2. amp-permission-eval (Bash) - Variable expansion, policy checks, prompts

CONFIG FILES (~/.config/amp-permissions/):
  readonly-commands.txt    - Commands allowed without prompt
  sensitive-paths.txt      - Paths that always prompt
  reject-patterns.txt      - Patterns always blocked
  always-allowed-paths.txt - Paths always allowed (/tmp, etc.)
  always-ask-patterns.txt  - Patterns that always prompt
  interpreters.txt         - Script interpreters to monitor
EOF
}

#------------------------------------------------------------------------------
# Main
#------------------------------------------------------------------------------

if [[ "${1:-}" == --* ]]; then
  case "$1" in
  --test) cmd_test "${2:-'{}'}" "${3:-Bash}" ;;
  --parse) cmd_parse "${2:-}" ;;
  --log) cmd_log ;;
  --edit) cmd_edit "${2:-}" ;;
  --help | -h) cmd_help ;;
  *)
    echo "Unknown option: $1"
    cmd_help
    exit 1
    ;;
  esac
  exit $?
fi

# Delegate mode
TOOL_NAME="${AGENT_TOOL_NAME:-}"
ARGS=$(cat)
WORK_DIR="${PWD:-$(pwd)}"

case "$TOOL_NAME" in
Bash) handle_bash ;;
edit_file | create_file) handle_file_tool ;;
*) exit 0 ;;
esac
