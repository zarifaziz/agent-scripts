#!/usr/bin/env bash
#
# amp-sandboxed - Run Amp with filesystem isolation
#
# Writes are restricted to current directory only.
# Rest of $HOME is read-only.
#
# Usage: amp-sandboxed [amp args...]
#
# Modes:
#   SANDBOX_MODE=native  - Use macOS sandbox-exec (default, faster)
#   SANDBOX_MODE=docker  - Use Docker container (more portable)

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
SANDBOX_MODE="${SANDBOX_MODE:-native}"

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[0;33m'
NC='\033[0m' # No Color

log_info() { echo -e "${GREEN}[sandbox]${NC} $*" >&2; }
log_warn() { echo -e "${YELLOW}[sandbox]${NC} $*" >&2; }
log_error() { echo -e "${RED}[sandbox]${NC} $*" >&2; }

# Get the amp binary path
get_amp_path() {
    # Check common locations
    if command -v amp &>/dev/null; then
        command -v amp
    elif [[ -x "$HOME/.bun/bin/amp" ]]; then
        echo "$HOME/.bun/bin/amp"
    elif [[ -x "/usr/local/bin/amp" ]]; then
        echo "/usr/local/bin/amp"
    else
        log_error "amp not found in PATH"
        exit 1
    fi
}

run_native_sandbox() {
    local sandbox_profile="$SCRIPT_DIR/amp.sb"
    local amp_bin
    amp_bin="$(get_amp_path)"
    
    if [[ ! -f "$sandbox_profile" ]]; then
        log_error "Sandbox profile not found: $sandbox_profile"
        exit 1
    fi
    
    log_info "Mode: native (sandbox-exec)"
    log_info "Writable: $PWD"
    log_info "Read-only: $HOME (except PWD)"
    
    exec sandbox-exec \
        -f "$sandbox_profile" \
        -D "PWD=$PWD" \
        -D "HOME=$HOME" \
        -D "TMPDIR=${TMPDIR:-/tmp}" \
        "$amp_bin" --no-ide "$@"
}

run_docker_sandbox() {
    local image_name="amp-sandbox"
    local container_name="amp-sandbox-$$"
    
    # Build image if needed
    if ! docker image inspect "$image_name" &>/dev/null; then
        log_info "Building Docker image (first run)..."
        docker build \
            --build-arg "HOST_UID=$(id -u)" \
            --build-arg "HOST_GID=$(id -g)" \
            -t "$image_name" \
            "$SCRIPT_DIR"
    fi
    
    log_info "Mode: docker"
    log_info "Writable: $PWD (mounted as /workspace)"
    log_info "Read-only: $HOME"
    
    # Run amp in container
    # - PWD mounted read-write at /workspace
    # - HOME mounted read-only for config/credentials access
    # - Amp config passed through
    exec docker run --rm -it \
        --name "$container_name" \
        -v "$PWD:/workspace:rw" \
        -v "$HOME:$HOME:ro" \
        -v "$HOME/.config/amp:/home/ampuser/.config/amp:ro" \
        -e "HOME=$HOME" \
        -e "AMP_API_KEY=${AMP_API_KEY:-}" \
        -w /workspace \
        "$image_name" \
        --no-ide "$@"
}

# Permission escalation helper (for future use)
# This would prompt for specific path access
request_write_access() {
    local path="$1"
    
    # macOS authorization prompt
    if command -v osascript &>/dev/null; then
        local result
        result=$(osascript -e "
            display dialog \"Amp requests write access to:\\n$path\" \\
                with title \"Sandbox Permission\" \\
                buttons {\"Deny\", \"Allow\"} \\
                default button \"Deny\" \\
                with icon caution
            return button returned of result
        " 2>/dev/null) || true
        
        if [[ "$result" == "Allow" ]]; then
            return 0
        fi
    fi
    return 1
}

main() {
    case "$SANDBOX_MODE" in
        native|sandbox)
            run_native_sandbox "$@"
            ;;
        docker)
            run_docker_sandbox "$@"
            ;;
        *)
            log_error "Unknown SANDBOX_MODE: $SANDBOX_MODE (use 'native' or 'docker')"
            exit 1
            ;;
    esac
}

main "$@"
