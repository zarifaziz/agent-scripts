;; Amp Sandbox Profile
;; Allows writes only to PWD subtree, read-only everywhere else
;; Usage: sandbox-exec -f amp.sb -D PWD=/path/to/workdir -D HOME=/Users/mac amp

(version 1)

;; Start with deny-all
(deny default)

;; Allow basic process operations
(allow process-fork)
(allow process-exec)
(allow signal)
(allow sysctl-read)
(allow process-info* (target self))
(allow process-info-pidinfo)

;; Allow all network (amp needs internet)
(allow network*)

;; Allow read everywhere (global read access)
(allow file-read*)

;; Allow write ONLY to PWD subtree
(allow file-write*
    (subpath (param "PWD"))
    (subpath (param "TMPDIR"))
    (subpath "/private/tmp")
    (subpath "/private/var/folders"))  ;; macOS temp

;; Allow creating/deleting ONLY in PWD
(allow file-write-create
    (subpath (param "PWD")))

;; Allow mach services (needed for most apps)
(allow mach-lookup)
(allow mach-register)

;; Allow IPC
(allow ipc-posix*)

;; Allow TTY (for interactive terminal)
(allow file-ioctl)

;; Note: Rules are evaluated top-to-bottom, first match wins
;; PWD allow is above, so writes to PWD work even if under HOME
