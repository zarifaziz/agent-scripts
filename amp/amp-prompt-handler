#!/usr/bin/env bash
#
# amp-prompt-handler - Default prompt handler for amp-permission
#
# Receives JSON on stdin with title, message, context
# Exit codes: 0 = allow, 2 = deny (any error = deny with notification)
#
# macOS only - uses osascript dialogs exclusively

set -uo pipefail

LOG_FILE="${AMP_PROMPT_LOG:-$HOME/.config/amp-permissions/prompt.log}"
TIMEOUT_SECS="${AMP_PROMPT_TIMEOUT:-60}"

log_prompt() {
    local result="$1"
    local timestamp=$(date '+%Y-%m-%d %H:%M:%S')
    echo "[$timestamp] [$TMUX_CTX] $result | $TITLE | $CMD" >> "$LOG_FILE" 2>/dev/null || true
}

notify_error() {
    local error_msg="$1"
    osascript -e "display notification \"$error_msg\" with title \"Amp Permission - AUTO DENIED\" sound name \"Basso\"" 2>/dev/null || true
    log_prompt "ERROR: $error_msg"
    exit 2
}

notify_timeout() {
    local notif_title="Amp Permission"
    [[ "$TMUX_CTX" != "no-tmux" ]] && notif_title="Amp Permission [$TMUX_CTX]"
    local pwd_short=$(echo "$PWD_PATH" | awk -F/ '{print $(NF-1)"/"$NF}')
    osascript -e "display notification \"Timed out - auto denied\n[$pwd_short]\" with title \"$notif_title\" sound name \"Basso\"" 2>/dev/null || true
}

visit_tmux_pane() {
    [[ -z "${TMUX:-}" ]] && return
    local target
    if [[ -n "${TMUX_PANE:-}" ]]; then
        target=$(tmux display-message -t "$TMUX_PANE" -p '#S:#I' 2>/dev/null)
    else
        target=$(tmux display-message -p '#S:#I' 2>/dev/null)
    fi
    tmux switch-client -t "$target" 2>/dev/null || tmux select-window -t "$target" 2>/dev/null
    for app in WezTerm iTerm Alacritty kitty Terminal; do
        if pgrep -qf "$app"; then
            open -a "$app"
            break
        fi
    done
}

#------------------------------------------------------------------------------
# Main
#------------------------------------------------------------------------------

# Require osascript on macOS
if ! command -v osascript &>/dev/null; then
    echo "ERROR: osascript not found" >&2
    exit 2
fi

# Require jq
if ! command -v jq &>/dev/null; then
    notify_error "jq not installed"
fi

# Read and parse JSON
INPUT=$(cat) || notify_error "Failed to read stdin"
[[ -z "$INPUT" ]] && notify_error "Empty input"

TITLE=$(echo "$INPUT" | jq -r '.title // empty') || notify_error "JSON parse failed"
MESSAGE=$(echo "$INPUT" | jq -r '.message // empty')
CMD=$(echo "$INPUT" | jq -r '.context.cmd // empty')
PWD_PATH=$(echo "$INPUT" | jq -r '.context.pwd // empty')
TMUX_CTX=$(echo "$INPUT" | jq -r '.context.tmux // "no-tmux"')

[[ -z "$TITLE" ]] && notify_error "Missing title in input"
[[ -z "$MESSAGE" ]] && notify_error "Missing message in input"

# Escape for osascript
escaped_msg="${MESSAGE//\"/\\\"}"
escaped_title="${TITLE//\"/\\\"}"
full_title="[$TMUX_CTX] $escaped_title"

# Dialog loop (for Visit button)
while true; do
    buttons='{"Deny", "Allow"}'
    if [[ "$TMUX_CTX" != "no-tmux" ]] && [[ -n "${TMUX:-}" ]]; then
        buttons='{"Deny", "Visit", "Allow"}'
    fi

    osa_output=$(osascript -e "
        set dialogResult to display dialog \"$escaped_msg\" with title \"$full_title\" buttons $buttons default button \"Deny\" with icon caution giving up after $TIMEOUT_SECS
        return (button returned of dialogResult) & \"|\" & (gave up of dialogResult)
    " 2>&1)
    osa_exit=$?

    # osascript failure (not timeout/cancel) = auto deny
    if [[ $osa_exit -ne 0 ]] && [[ ! "$osa_output" =~ "gave up" ]]; then
        # User pressed cancel or osascript error
        if [[ "$osa_output" =~ "User canceled" ]]; then
            log_prompt "CANCEL"
            exit 2
        fi
        notify_error "Dialog failed: ${osa_output:0:50}"
    fi

    # Parse result
    result="${osa_output%%|*}"
    gave_up="${osa_output##*|}"

    # Visit button - switch pane and re-prompt
    if [[ "$result" == "Visit" ]]; then
        visit_tmux_pane
        sleep 0.3
        continue
    fi

    # Timeout
    if [[ "$gave_up" == "true" ]]; then
        notify_timeout
        log_prompt "TIMEOUT"
        exit 2
    fi

    # Allow or Deny
    if [[ "$result" == "Allow" ]]; then
        log_prompt "ALLOW"
        exit 0
    else
        log_prompt "DENY"
        exit 2
    fi
done
